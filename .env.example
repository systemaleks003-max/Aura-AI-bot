# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/flirt_bot

# ZhipuAI API Key (для glm-5.3-flash — генерация текста)
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter API Key (для Grok — генерация фото)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Redis (для очередей)
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin ID (Telegram user ID)
ADMIN_ID=your_telegram_user_id
